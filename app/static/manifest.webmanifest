{
  "name": "UPSC Daily \u2013 Current Affairs",
  "short_name": "UPSC Daily",
  "description": "Daily UPSC CSE current affairs from PIB and The Hindu with notes, PDFs and monthly quizzes.",
  "start_url": "/#/today",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f3ee",
  "theme_color": "#c2410c",
  "icons": [
    {
      "src": "/static/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/static/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "/",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "categories": [
    "education",
    "news"
  ],
  "screenshots": [
    {
      "src": "/static/screenshot-tablet-portrait.jpg",
      "sizes": "800x1280",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Today's UPSC notes grouped by subject"
    },
    {
      "src": "/static/screenshot-tablet-landscape.jpg",
      "sizes": "1280x800",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Daily notes on a tablet in landscape"
    }
  ]
}